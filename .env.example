# OpenAI-compatible creds the browser-use agent drives. Point BASE_URL at your
# provider/proxy; the agent uses the model in WD_AGENT_MODEL.
OPENAI_API_KEY=sk-...
BASE_URL=

# Optional second provider. browser-use switches to it for the rest of a run when
# the primary returns a retryable error (401/402/429/5xx) — worth setting when
# BASE_URL points at a proxy. Only the base URL is required; the key falls back to
# OPENAI_API_KEY and the model to WD_AGENT_MODEL.
# WD_FALLBACK_BASE_URL=https://api.openai.com/v1
# WD_FALLBACK_API_KEY=sk-...
# WD_FALLBACK_MODEL=gpt-5.4

# Optional overrides (prefix WD_):
# WD_DOWNLOADS_DIR=downloads
# WD_HEADLESS=false                  # set false to watch the agent's browser
# Reuse one browser for every article in a run (default true). Required for a
# manual sign-in to hold: institutional SSO (Shibboleth/SAML) hands out
# session-scoped cookies that die with the browser process, so a per-article
# browser throws the login away after the first paper. Pair with `--login`.
# Set false (or pass --no-shared-browser) to isolate each article instead.
# WD_SHARE_BROWSER=true
# WD_AGENT_MODEL=gpt-5.4             # a smaller model is the biggest cost lever
# Efficiency knobs (defaults already tuned for cheaper/faster runs):
# WD_AGENT_USE_VISION=false          # true = send screenshots (slower/costlier, more robust)
# WD_AGENT_FLASH_MODE=true
# WD_AGENT_MAX_STEPS=15
# WD_AGENT_MAX_ACTIONS_PER_STEP=8
# WD_AGENT_USE_JUDGE=false           # true = extra LLM call grading each run's trace
# Timeouts, in seconds. Raise both together for a slow provider — a step must
# outlast the LLM call it waits on, so STEP_TIMEOUT has to stay above LLM_TIMEOUT.
# WD_AGENT_LLM_TIMEOUT=120
# WD_AGENT_STEP_TIMEOUT=150
# Ceiling on one completion (browser-use's own default is a too-tight 4096).
# Reasoning tokens count against it on any model whose name contains gpt-5 / o1 /
# o3 / o4, and a step that spends the whole budget thinking returns an EMPTY
# message, which shows up as a "step failed" with no usable error.
# WD_AGENT_MAX_COMPLETION_TOKENS=16384
# Verify-step cost: price of WD_VERIFY_MODEL in USD per 1,000,000 tokens, used to
# fill verify_cost_usd / total_cost_usd in downloads/bookkeeping.csv.
# WD_VERIFY_COST_PER_MTOK=2.5
